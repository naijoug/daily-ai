---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { allPosts } from '../lib/posts';
const posts = (await allPosts()).filter((p) => p.data.type === 'tech');
---
<Base wide title="科技速递">
  <h1>科技速递</h1>
  <p class="muted">新产品 / 开源、科技新闻和中文社区精选。共 {posts.length} 篇。</p>
  <Gallery posts={posts} />
</Base>
