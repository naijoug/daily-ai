---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { allDays } from '../../lib/days';
import { TAGS, tagSlug } from '../../content.config';
export async function getStaticPaths() {
  const days = await allDays();
  return TAGS.map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag, days: days.filter((d) => d.tags.includes(tag)) } })).filter((x) => x.props.days.length);
}
const { tag, days } = Astro.props;
---
<Base wide title={`Tag: ${tag}`}>
  <h1>Tag: {tag}</h1>
  <p class="muted" style="margin-bottom:20px">{days.length} {days.length === 1 ? "day" : "days"}</p>
  <Gallery days={days} />
</Base>
