---
import { tagSlug } from '../../content.config';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { url } from '../../lib/posts';
import { allDays, hhmm, covEn } from '../../lib/days';
export async function getStaticPaths() {
  const days = await allDays();
  return days.map((d, i) => ({ params: { date: d.date }, props: { day: d, newer: days[i - 1], older: days[i + 1] } }));
}
const { day, newer, older } = Astro.props;
const render1 = async (p: any) => ({ p, Content: (await render(p)).Content });
const sections = [
  { key: 'x-ai', label: 'AI Hot', list: await Promise.all(day.xai.map(render1)) },
  { key: 'tech', label: 'Tech', list: await Promise.all(day.tech.map(render1)) },
].filter((s) => s.list.length);
---
<Base title={day.title} description={day.summary}>
  <article class="prose day" data-pagefind-body data-day={day.date} data-total={day.total} data-pids={day.pids.join(',')}>
    <p class="muted crumb"><a href={url('/')}>Daily AI</a> / Daily</p>
    <h1>{day.title}</h1>
    <p class="dsum">{day.summary}</p>
    <div class="dbar" data-pagefind-ignore>
      <span class="muted">Beijing Time · {day.posts.length} {day.posts.length === 1 ? 'run' : 'runs'} · {day.total} items</span>
      <span class="dprog" data-dprog>0/{day.total} read</span>
      <label class="dhide"><input type="checkbox" data-hideread /> Hide read</label>
    </div>
    <div class="dtags">{day.tags.map((t) => <a class="chip" href={url(`/tags/${tagSlug(t)}/`)}>{t}</a>)}</div>
    {sections.map((s) => <section class="dsec">
      <h2 class="dhead"><span class={`gbadge ${s.key}`}>{s.label}</span></h2>
      {s.list.map(({ p, Content }) => <div class="entry" id={p.id}>
        <div class="tmark" data-pagefind-ignore><span>{hhmm(p.data.date)}</span>{p.data.coverage && <em>{covEn(p.data.coverage)}</em>}</div>
        <div class="ebody"><Content /></div>
      </div>)}
    </section>)}
  </article>
  <nav class="pager" aria-label="Pagination">
    <span>{older && <a href={url(`/day/${older.date}/`)}>← {older.title}</a>}</span>
    <span>{newer && <a href={url(`/day/${newer.date}/`)}>{newer.title} →</a>}</span>
  </nav>
</Base>
<script>
  import { load, save } from '../../lib/store';
  import { favBtn, readBtn, setFav, setRead, starsHtml, setStars, starKeys } from '../../lib/icons';
  const art = document.querySelector<HTMLElement>('article.day')!;
  const day = art.dataset.day!;
  const total = Number(art.dataset.total);
  const items = [...art.querySelectorAll<HTMLElement>('li.item')];
  const prog = art.querySelector('[data-dprog]')!;
  // 手动标为未读的条目：本次会话内不再自动标已读
  const manualUnread = new Set<string>();
  const upd = () => {
    const st = load();
    let r = 0;
    for (const li of items) {
      const id = li.dataset.id!;
      const isRead = !!st.read[id]; if (isRead) r++;
      li.classList.toggle('read', isRead);
      setRead(li.querySelector('[data-act=read]')!, isRead);
      setFav(li.querySelector('[data-act=fav]')!, !!st.fav[id]);
      const rt = st.rating[id] || 0;
      setStars(li, rt);
    }
    prog.textContent = `${r}/${total} read`;
  };
  for (const li of items) {
    const meta = li.querySelector('.imeta')!;
    meta.setAttribute('data-pagefind-ignore', '');
    meta.insertAdjacentHTML('beforeend',
      starsHtml() +
      favBtn() + readBtn());
    starKeys(meta);
    meta.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      const st = load(); const id = li.dataset.id!;
      if (b.dataset.star) { const n = Number(b.dataset.star); if (st.rating[id] === n) delete st.rating[id]; else st.rating[id] = n; }
      else if (b.dataset.act === 'read') { if (st.read[id]) { delete st.read[id]; manualUnread.add(id); li.classList.remove('dim'); } else { st.read[id] = Date.now(); if (art.classList.contains('hideread')) li.classList.add('keep'); } }
      else if (b.dataset.act === 'fav') {
        if (st.fav[id]) delete st.fav[id];
        else { const t = li.querySelector('.itext')!; st.fav[id] = { id, day, html: t.innerHTML, text: (t.textContent || '').trim(), score: Number(li.dataset.score) || undefined, ts: Date.now() }; }
      }
      save(st); upd();
    });
    li.querySelector('.itext')!.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a')) return;
      const st = load(); const id = li.dataset.id!;
      if (!st.read[id]) { st.read[id] = Date.now(); save(st); upd(); }
    });
  }
  const hide = art.querySelector<HTMLInputElement>('[data-hideread]')!;
  hide.checked = localStorage.getItem('dailyai:hideread') === '1';
  const applyHide = () => { items.forEach((li) => li.classList.remove('keep')); art.classList.toggle('hideread', hide.checked); localStorage.setItem('dailyai:hideread', hide.checked ? '1' : '0'); };
  hide.addEventListener('change', applyHide); applyHide();
  upd();
  // ===== 自动已读：按内容长度计算停留时间 =====
  // 有效字数 units = CJK 字符 ×cjkWeight + 拉丁单词 ×wordWeight（不含链接文字、@handle、[AI:N] 标记）
  // fullReadSeconds = units / wpm * 60；requiredSeconds = clamp(fullReadSeconds * fraction, minSec, maxSec)
  // 只在条目 ≥visibleRatio 可见（或占满视口 ≥visibleRatio）、标签页可见、窗口聚焦、且 idleMs 内有用户输入时累计。
  // 离开视口只暂停不清零；离开超过 outResetMs 清零。单个 setInterval tick 累计。
  const CFG = Object.assign({ cjkWeight: 1, wordWeight: 2, wpm: 450, fraction: 0.5, minSec: 3, maxSec: 25, visibleRatio: 0.6, outResetMs: 30000, idleMs: 60000, tickMs: 250 }, (window as any).__dailyaiReadCfg || {});
  const unitsOf = (li: HTMLElement) => {
    const c = li.querySelector('.itext')!.cloneNode(true) as HTMLElement;
    c.querySelectorAll('a').forEach((a) => a.remove());
    const t = (c.textContent || '').replace(/https?:\/\/\S+/g, ' ').replace(/\[AI:?\s*\d\]/gi, ' ').replace(/@\w+/g, ' ');
    const cjk = (t.match(/[\u3400-\u4dbf\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]/g) || []).length;
    const words = (t.replace(/[\u3400-\u9fff\u3040-\u30ff\uac00-\ud7af]/g, ' ').match(/[A-Za-z0-9][A-Za-z0-9._'\-]*/g) || []).length;
    return cjk * CFG.cjkWeight + words * CFG.wordWeight;
  };
  type Tr = { li: HTMLElement; req: number; acc: number; out: number; btn: HTMLElement };
  const trs: Tr[] = items.map((li) => {
    const units = unitsOf(li);
    const req = Math.min(CFG.maxSec, Math.max(CFG.minSec, (units / CFG.wpm) * 60 * CFG.fraction));
    li.dataset.readSeconds = req.toFixed(1); li.dataset.readUnits = String(units);
    return { li, req, acc: 0, out: 0, btn: li.querySelector('[data-act=read]') as HTMLElement };
  });
  const autoRead = (li: HTMLElement) => {
    const id = li.dataset.id!; if (manualUnread.has(id)) return;
    const st = load(); if (st.read[id]) return;
    st.read[id] = Date.now(); save(st);
    if (art.classList.contains('hideread')) li.classList.add('keep');
    upd();
  };
  const paintRing = (t: Tr, unread: boolean) => {
    const pct = unread ? Math.min(100, (t.acc / t.req) * 100) : 0;
    t.btn.style.setProperty('--rp', pct.toFixed(1));
    t.btn.classList.toggle('prog', pct > 0);
    t.li.dataset.readAcc = t.acc.toFixed(1);
  };
  let lastInput = Date.now();
  const touch = () => { lastInput = Date.now(); };
  for (const ev of ['scroll', 'wheel', 'mousemove', 'keydown', 'touchstart', 'touchmove', 'pointerdown']) window.addEventListener(ev, touch, { passive: true, capture: true });
  let last = performance.now();
  setInterval(() => {
    const now = performance.now(); const dt = Math.min(now - last, CFG.tickMs * 4); last = now;
    const active = document.visibilityState === 'visible' && document.hasFocus() && Date.now() - lastInput < CFG.idleMs;
    const vh = innerHeight; const st = load();
    for (const t of trs) {
      const id = t.li.dataset.id!; const unread = !st.read[id];
      if (!unread || manualUnread.has(id)) { if (t.acc) { t.acc = 0; } paintRing(t, false); continue; }
      const r = t.li.getBoundingClientRect();
      const visH = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
      const enough = r.height > 0 && (visH / r.height >= CFG.visibleRatio || visH >= vh * CFG.visibleRatio);
      if (enough) {
        t.out = 0;
        if (active) { t.acc += dt / 1000; if (t.acc >= t.req) { t.acc = t.req; paintRing(t, true); autoRead(t.li); continue; } }
      } else {
        if (!t.out) t.out = Date.now();
        else if (t.acc && Date.now() - t.out > CFG.outResetMs) t.acc = 0;
      }
      paintRing(t, true);
    }
  }, CFG.tickMs);
  // 变暗与已读解耦：刚标已读的条目保持明亮，离开视口后才加 dim；页面加载时已读条目直接 dim。
  { const st = load(); items.forEach((li) => li.classList.toggle('dim', !!st.read[li.dataset.id!])); }
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((ents) => {
      for (const e of ents) if (!e.isIntersecting) (e.target as HTMLElement).classList.toggle('dim', (e.target as HTMLElement).classList.contains('read'));
    }, { threshold: [0] });
    items.forEach((li) => io.observe(li));
  }
</script>
