---
import { url, fmtDate } from '../lib/posts';
const { posts } = Astro.props;
const BADGE: Record<string, string> = { 'x-ai': 'AI 热点', tech: '科技站' };
function heads(body = '') {
  return body.split('\n').filter((l) => /^(\d+\.|[-*])\s/.test(l)).slice(0, 3).map((l) =>
    l.replace(/^(\d+\.|[-*])\s+/, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/https?:\/\/\S+/g, '')
     .replace(/[*_`]/g, '').split(/[：:（(。]/)[0].trim().slice(0, 60));
}
---
<div class="gallery">
  {posts.map((p) => (
    <a class="gcard" href={url(`/posts/${p.id}/`)} data-type={p.data.type}>
      <div class="gprev">
        <div class="gmeta"><span class={`gbadge ${p.data.type}`}>{BADGE[p.data.type]}</span><span>{fmtDate(p.data.date)}</span></div>
        <ul>{heads(p.body).map((h) => <li>{h}</li>)}</ul>
      </div>
      <div class="gtitle"><span class="gicon">📄</span><span>{p.data.title}</span></div>
    </a>
  ))}
</div>
