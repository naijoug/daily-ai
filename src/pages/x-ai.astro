---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { allPosts } from '../lib/posts';
const posts = (await allPosts()).filter((p) => p.data.type === 'x-ai');
---
<Base wide title="X AI 热点">
  <h1>X AI 热点</h1>
  <p class="muted">X 上的 AI 热点和有趣用法、干货。共 {posts.length} 篇。</p>
  <Gallery posts={posts} />
</Base>
