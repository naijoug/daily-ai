---
import Base from '../../layouts/Base.astro';
import { allPosts, url } from '../../lib/posts';
import { TAGS } from '../../content.config';
const posts = await allPosts();
const counts = TAGS.map((t) => [t, posts.filter((p) => p.data.tags.includes(t)).length] as const).filter(([, n]) => n > 0);
---
<Base title="标签">
  <h1>标签</h1>
  <p>{counts.map(([t, n]) => <a class="chip" href={url(`/tags/${t}/`)}>{t} · {n}</a>)}</p>
</Base>
