---
import { allPosts, url } from '../../lib/posts';
import { dayKey } from '../../lib/days';
export async function getStaticPaths() {
  return (await allPosts()).map((p) => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const to = url(`/day/${dayKey(post.data.date)}/#${post.id}`);
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8" />
<title>{post.data.title} | Daily AI</title>
<meta name="robots" content="noindex" />
<link rel="canonical" href={to} />
<meta http-equiv="refresh" content={`0; url=${to}`} />
</head><body><p>Moved to <a href={to}>{to}</a></p></body></html>
