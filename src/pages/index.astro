---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { url } from '../lib/posts';
import { allDays } from '../lib/days';
import { allProducts } from '../lib/products';
const days = await allDays();
const prods = await allProducts();
const newByDay: Record<string, { id: string; name: string }[]> = {};
for (const p of prods.sort((a, b) => (b.score || 0) - (a.score || 0))) (newByDay[p.firstSeen] ||= []).push({ id: p.id, name: p.name });
---
<Base wide>
  <h1 class="ptitle"><span>📰</span> Daily AI</h1>
  <p class="muted">One page per day: AI Hot and Tech digests from X. {days.length} days.</p>
  <div class="views">
    <span class="vlabel">▦ Daily</span>
    <a class="vsearch" href={url('/search/')} aria-label="Search">⌕ Search</a>
  </div>
  <Gallery days={days} newByDay={newByDay} />
</Base>
