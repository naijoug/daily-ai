---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/posts';
import { allDays } from '../../lib/days';
import { TAGS, tagSlug } from '../../content.config';
import I from '../../components/I.astro';
const days = await allDays();
const counts = TAGS.map((t) => [t, days.filter((d) => d.tags.includes(t)).length] as const).filter(([, n]) => n > 0);
---
<Base tkey="tags.title">
  <I tag="h1" k="tags.title" />
  <p>{counts.map(([tg, n]) => <a class="chip" href={url(`/tags/${tagSlug(tg)}/`)}><I k={`tag.${tg}`} /> · <I k="days" a={{ n }} /></a>)}</p>
</Base>
