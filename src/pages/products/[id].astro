---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/posts';
import { favBtn, readBtn, starsHtml } from '../../lib/icons';
import I from '../../components/I.astro';
import L from '../../components/L.astro';
import { t, iattr } from '../../lib/i18n';
import { allProducts, badges, mentionsIndex } from '../../lib/products';
export async function getStaticPaths() {
  const ps = await allProducts();
  const idx = await mentionsIndex(ps);
  return ps.map((p) => ({ params: { id: p.id }, props: { p, mentions: idx.get(p.id) || [] } }));
}
const { p, mentions } = Astro.props;
const groups = new Map<string, typeof p.rankings>();
for (const r of p.rankings) { const k = `${r.badge || r.source} · ${r.list}`; if (!groups.has(k)) groups.set(k, []); groups.get(k)!.push(r); }
const hist = [...groups.entries()].map(([k, rs]) => ({ k, rs: [...rs].sort((a, b) => (a.date < b.date ? 1 : -1)) }))
  .sort((a, b) => (a.rs[0].date < b.rs[0].date ? 1 : -1));
const host = p.url.replace(/^https?:\/\/(www\.)?/, '');
---
<Base title={p.name} description={p.oneLinerEn || p.oneLiner}>
  <article class="prose pdetail" data-id={p.id} data-first={p.firstSeen} data-score={p.score || 0} data-pagefind-body>
    <p class="muted crumb"><I tag="a" href={url('/products/')} k="p.crumb" /> / <I k={`cat.${p.category}`} /></p>
    <h1>{p.name}</h1>
    <p class="dsum"><L en={p.oneLinerEn} zh={p.oneLiner} /></p>
    <div class="dbar" data-pagefind-ignore>
      <span class={`gbadge ${p.region === 'cn' ? 'tech' : ''}`}><I k={`region.${p.region}`} /></span>
      {p.maker && <span class="muted">{p.maker}</span>}
      {p.score && <span class={`ascore s${p.score}`} {...iattr({ title: 'ai.score', 'aria-label': 'ai.score' }, { n: p.score })}>{p.score}</span>}
      {p.growth != null && <span class:list={['grow', p.growth >= 0 ? 'up' : 'down']}>{p.growth >= 0 ? '↑' : '↓'}{Math.abs(p.growth).toFixed(2)}% <span class="muted">{p.growthNote}</span></span>}
      <I class="muted" k="p.first" a={{ d: p.firstSeen }} />
    </div>
    <div class="imeta pmeta" data-pagefind-ignore>
      <a class="ibtn" href={p.url} target="_blank" rel="noopener">{host} ↗</a>
      {p.domains.map((d) => <a class="ibtn" href={d} target="_blank" rel="noopener">{d.replace(/^https?:\/\/(www\.)?/, '')} ↗</a>)}
      <Fragment set:html={starsHtml() + favBtn() + readBtn()} />
    </div>
    {badges(p).length > 0 && <div class="dtags">{badges(p).map((r) => <span class="rbadge" title={r.list}>{r.badge} #{r.rank}</span>)}</div>}

    <I tag="h2" k="p.hist" />
    {hist.length === 0 ? <I tag="p" class="muted" k="p.nohist" /> : <div class="rscroll"><table class="rtable">
      <thead><tr><th><I k="p.th.list" /></th><th><I k="p.th.period" /></th><th>#</th><th><I k="p.th.value" /></th><th><I k="p.th.mom" /></th></tr></thead>
      <tbody>{hist.flatMap(({ k, rs }) => rs.map((r, i) => {
        const mom = r.mom && /^-?[\d.]+%$/.test(r.mom) ? parseFloat(r.mom) : null;
        return <tr>
          <td>{i === 0 ? <a href={r.url} target="_blank" rel="noopener">{k}</a> : <span class="muted">〃</span>}</td>
          <td class="rv">{r.date}</td><td class="rn">{r.rank ?? '—'}</td><td class="rv">{r.value || '—'}</td>
          <td class:list={['rm', { up: mom !== null && mom > 0, down: mom !== null && mom < 0 }]}>{r.mom || '—'}</td>
        </tr>;
      }))}</tbody>
    </table></div>}
    <I tag="p" class="muted rnote" k="p.hist.note" />

    <h2><I k="p.mentions" /> <span class="muted">· {mentions.length}</span></h2>
    {mentions.length === 0 ? <I tag="p" class="muted" k="p.nomentions" /> :
      <ol class="items mlist">{mentions.slice(0, 40).map((m) => <li class="item"><div class="itext"><a href={url(`/day/${m.day}/#${m.id}`)}>{m.day}</a> · {m.text}</div></li>)}</ol>}
  </article>
  <nav class="pager"><I tag="a" href={url('/products/')} k="p.all" /><I tag="a" href={url('/products/#models')} k="p.models" /></nav>
</Base>
<script>
  import { load, save } from '../../lib/store';
  import { setFav, setRead, setStars, starKeys } from '../../lib/icons';
  import { getLang, onLang } from '../../lib/i18n';
  const art = document.querySelector<HTMLElement>('.pdetail')!;
  const k = `product:${art.dataset.id}`;
  const meta = art.querySelector('.pmeta')!;
  const dsum = () => (art.querySelector(`.dsum [data-l=${getLang()}]`) || art.querySelector('.dsum'))!.textContent || '';
  const upd = () => {
    const st = load();
    const fav = !!st.fav[k]; const fb = meta.querySelector('[data-act=fav]')!;
    setFav(fb, fav);
    setRead(meta.querySelector('[data-act=read]')!, !!st.read[k], 'seen');
    const rt = st.rating[k] || 0;
    setStars(meta, rt);
  };
  starKeys(meta);
  meta.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    const st = load();
    if (b.dataset.star) { const n = Number(b.dataset.star); if (st.rating[k] === n) delete st.rating[k]; else st.rating[k] = n; }
    else if (b.dataset.act === 'read') { if (st.read[k]) delete st.read[k]; else st.read[k] = Date.now(); }
    else if (b.dataset.act === 'fav') {
      if (st.fav[k]) delete st.fav[k];
      else st.fav[k] = { id: k, day: art.dataset.first!, html: `<p><strong>${art.querySelector('h1')!.textContent}</strong>: ${dsum()}</p>`, text: dsum(), score: Number(art.dataset.score) || undefined, ts: Date.now() };
    }
    save(st); upd();
  });
  upd(); onLang(upd);
</script>
