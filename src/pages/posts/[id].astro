---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { allPosts, url, TYPE_LABEL, fmtDate } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((p, i) => ({ params: { id: p.id }, props: { post: p, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="prose" data-pagefind-body>
    <a class="chip type" href={url(`/${post.data.type}/`)} data-pagefind-filter="type">{TYPE_LABEL[post.data.type]}</a>
    <h1>{post.data.title}</h1>
    <p class="muted">{fmtDate(post.data.date)}（北京时间）{post.data.coverage && <> · {post.data.coverage}</>}</p>
    <div>{post.data.tags.map((t) => <a class="chip" href={url(`/tags/${t}/`)}>{t}</a>)}</div>
    <Content />
  </article>
  <div class="pager">
    <span>{newer && <a href={url(`/posts/${newer.id}/`)}>← {newer.data.title}</a>}</span>
    <span>{older && <a href={url(`/posts/${older.id}/`)}>{older.data.title} →</a>}</span>
  </div>
</Base>
