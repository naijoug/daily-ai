---
import { url } from '../lib/posts';
import type { Day } from '../lib/days';
const { days } = Astro.props as { days: Day[] };
---
<div class="gallery">
  {days.map((d) => (
    <a class="gcard" href={url(`/day/${d.date}/`)}>
      <div class="gprev">
        {d.aiHeads.length > 0 && <div class="gsect"><span class="gbadge x-ai">AI Hot</span><ul>{d.aiHeads.map((h) => <li>{h}</li>)}</ul></div>}
        {d.techHeads.length > 0 && <div class="gsect"><span class="gbadge tech">Tech</span><ul>{d.techHeads.map((h) => <li>{h}</li>)}</ul></div>}
      </div>
      <div class="gtitle"><span class="gicon">📄</span><span>{d.title}</span></div>
    </a>
  ))}
</div>
