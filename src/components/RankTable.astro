---
import I from './I.astro';
import type { Snapshot } from '../lib/products';
interface Props { s: Snapshot; history?: Snapshot[]; limit?: number; pmap?: Record<string, string> }
const { s, history = [], limit = 20, pmap = {} } = Astro.props;
const rows = s.rows.slice(0, limit);
const hasRank = rows.some((r) => r.rank != null);
const hasMom = rows.some((r) => r.mom);
const hasVal = rows.some((r) => r.value);
const pd = s.period || s.date;
---
<section class="rcard">
  <header class="rhead">
    <div>
      <div class="rtitle">{s.sourceName} · {s.list}</div>
      <div class="muted rsub">{s.metric}{s.metric ? ' · ' : ''}<I k="r.period" a={{ d: pd }} />{s.published && s.published !== pd && <Fragment> · <I k="r.published" a={{ d: s.published }} /></Fragment>}{s.manual && <Fragment> · <I k="r.manual" /></Fragment>}</div>
    </div>
    <I tag="a" class="ibtn" href={s.url} target="_blank" rel="noopener" k="r.source" />
  </header>
  <div class="rscroll"><table class="rtable">
    <thead><tr>{hasRank && <th>#</th>}<th><I k="r.name" /></th>{hasVal && <th><I k={s.kind === 'feed' && !hasRank ? 'r.summary' : 'r.value'} /></th>}{hasMom && <th><I k="r.mom" /></th>}</tr></thead>
    <tbody>{rows.map((r, i) => {
      const pid = pmap[r.name];
      const mom = r.mom && /^-?[\d.]+%$/.test(r.mom) ? parseFloat(r.mom) : null;
      return <tr>
        {hasRank && <td class="rn">{r.rank}</td>}
        <td class="rname">{pid ? <a href={pid}>{r.name}</a> : r.url ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a> : r.name}{r.org && <span class="muted"> · {r.org}</span>}{r.extra && <span class="chip rx">{r.extra}</span>}</td>
        {hasVal && <td class="rv">{r.value}</td>}
        {hasMom && <td class:list={['rm', { up: mom !== null && mom > 0, down: mom !== null && mom < 0 }]}>{r.mom}</td>}
      </tr>;
    })}</tbody>
  </table></div>
  {s.note && <p class="muted rnote">{s.note}</p>}
  {history.length > 1 && <p class="muted rnote"><I k="r.earlier" a={{ l: history.map((h) => h.period || h.date) }} /></p>}
</section>
