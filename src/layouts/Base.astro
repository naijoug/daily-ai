---
import { url } from '../lib/posts';
interface Props { title?: string; description?: string; wide?: boolean }
const { title, wide = false, description = '每日 AI 与科技动态汇总' } = Astro.props;
const full = title ? `${title} | Daily AI` : 'Daily AI · 每日 AI 动态';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Daily AI" href={url('/rss.xml')} />
  <script is:inline>
    (function(){var t=localStorage.getItem('theme');if(!t)t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';document.documentElement.dataset.theme=t;})();
  </script>
</head>
<body>
  <header class="site">
    <div class:list={["wrap bar", { wide }]}>
      <a class="brand" href={url('/')}>Daily AI</a>
      <nav>
        <a href={url('/')} class={path === url('/') || path === url('') ? 'on' : ''}>首页</a>
        <a href={url('/tags/')} class={path.startsWith(url('/tags')) ? 'on' : ''}>标签</a>
        <a href={url('/search/')} class={path.startsWith(url('/search')) ? 'on' : ''}>搜索</a>
        <a href={url('/rss.xml')}>RSS</a>
        <button id="theme" type="button" aria-label="切换深浅色">◐</button>
      </nav>
    </div>
  </header>
  <main class:list={["wrap", { wide }]}><slot /></main>
  <footer class="wrap foot">Daily AI · 内容来自每日汇总 · <a href={url('/rss.xml')}>订阅 RSS</a></footer>
  <script is:inline>
    document.getElementById('theme').addEventListener('click',function(){var d=document.documentElement;var t=d.dataset.theme==='dark'?'light':'dark';d.dataset.theme=t;localStorage.setItem('theme',t);});
  </script>
</body>
</html>
<style is:global>
  :root { --bg:#ffffff; --fg:#37352f; --muted:#787774; --line:rgba(55,53,47,.12); --card:#ffffff; --prev:#f7f6f3; --hover:#f1f1ef; --accent:#2383e2; --chip:#f1f1ef; --chipfg:#37352f; --b1:#e7f3f8; --b1f:#1f6c9f; --b2:#fbecdd; --b2f:#a65d1e; color-scheme: light; }
  [data-theme=dark] { --bg:#191919; --fg:#e6e6e6; --muted:#9b9b9b; --line:rgba(255,255,255,.08); --card:#2f2f2f; --prev:#373737; --hover:#3a3a3a; --accent:#529cca; --chip:#373737; --chipfg:#d4d4d4; --b1:#1f3a4d; --b1f:#8ec7ec; --b2:#4a3220; --b2f:#f0b47c; color-scheme: dark; }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--fg); }
  body { margin:0; font: 16px/1.8 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
  header.site { border-bottom: 1px solid var(--line); position: sticky; top:0; background: var(--bg); z-index: 5; }
  .bar { display:flex; align-items:center; justify-content:space-between; height:56px; gap:12px; }
  .brand { font-weight:700; font-size:18px; color: var(--fg); }
  nav { display:flex; gap:14px; align-items:center; flex-wrap:wrap; font-size:15px; }
  nav a { color: var(--muted); } nav a.on { color: var(--fg); font-weight:600; }
  #theme { background:none; border:1px solid var(--line); color:var(--fg); border-radius:6px; cursor:pointer; padding:2px 8px; }
  main { padding: 28px 20px 40px; }
  h1 { font-size: 26px; line-height:1.4; margin: 0 0 8px; }
  .muted { color: var(--muted); font-size: 14px; }
  .chip { display:inline-block; background:var(--chip); color:var(--chipfg); border-radius:999px; padding:0 10px; font-size:12.5px; margin: 0 6px 4px 0; line-height:22px; }
  .chip.type { background: transparent; border:1px solid var(--line); color: var(--muted); }
  ul.posts { list-style:none; padding:0; margin:0; }
  ul.posts li { border:1px solid var(--line); background:var(--card); border-radius:10px; padding:14px 16px; margin-bottom:12px; }
  ul.posts h2 { font-size:18px; margin:2px 0 4px; } ul.posts h2 a { color: var(--fg); }
  ul.posts p { margin: 4px 0 8px; color: var(--muted); font-size: 14.5px; }
  .filters { margin: 12px 0 20px; display:flex; gap:8px; }
  .filters button { border:1px solid var(--line); background:var(--card); color:var(--fg); border-radius:999px; padding:3px 14px; cursor:pointer; font-size:14px; }
  .filters button.on { background: var(--fg); color: var(--bg); }
  article.prose { overflow-wrap: anywhere; }
  article.prose h2 { font-size: 20px; margin-top: 32px; padding-bottom:4px; border-bottom:1px solid var(--line); }
  article.prose li { margin-bottom: 10px; }
  article.prose blockquote { margin: 16px 0; padding: 4px 14px; border-left: 3px solid var(--line); color: var(--muted); }
  article.prose code { background: var(--chip); padding: 1px 5px; border-radius: 4px; font-size: .9em; }
  .foot { color: var(--muted); font-size: 13px; padding: 24px 20px 40px; border-top: 1px solid var(--line); }
  .pager { display:flex; justify-content:space-between; gap:12px; margin-top: 36px; font-size:14px; }
  .brand { white-space:nowrap; }
  @media (max-width: 600px) { nav { flex-wrap:nowrap; overflow-x:auto; gap:12px; font-size:14px; white-space:nowrap; } }
  .wrap.wide { max-width: 1120px; padding-left: 40px; padding-right: 40px; }
  main.wide { padding-top: 48px; }
  .ptitle { font-size: 40px; font-weight: 700; margin: 0 0 6px; display:flex; gap:12px; align-items:center; }
  .views { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line); margin: 24px 0 20px; }
  .vlabel { font-size:14px; font-weight:600; padding:6px 8px; border-bottom:2px solid var(--fg); margin-bottom:-1px; }
  .gsect { margin-bottom:8px; } .gsect .gbadge { font-size:11px; display:inline-block; margin-bottom:4px; }
  .gprev { height:200px !important; }
  .gsect li { -webkit-line-clamp:1 !important; margin-bottom:2px !important; }
  .crumb { margin:0 0 6px; }
  .day h1 { font-size:32px; margin-top:4px; }
  .dsec { margin-top:36px; }
  h2.dhead { border:none !important; margin:0 0 8px !important; padding:0 !important; font-size:15px !important; }
  h2.dhead .gbadge { font-size:13px; padding:2px 10px; }
  .entry { margin: 20px 0 28px; padding-left:16px; border-left:2px solid var(--line); }
  .tmark { display:flex; gap:10px; align-items:baseline; font-size:12.5px; color:var(--muted); }
  .tmark span { font-variant-numeric: tabular-nums; font-weight:600; color:var(--fg); background:var(--chip); border-radius:4px; padding:0 6px; }
  .tmark em { font-style:normal; }
  .ebody { line-height:1.75; font-size:15.5px; }
  article.prose .ebody h2 { font-size:16px; border:none; margin:18px 0 6px; padding:0; color:var(--muted); }
  .vtabs { display:flex; gap:4px; }
  .vtabs button { background:none; border:none; color:var(--muted); font:inherit; font-size:14px; padding:6px 8px; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; border-radius:4px 4px 0 0; }
  .vtabs button:hover, .vsearch:hover { background: var(--hover); text-decoration:none; }
  .vtabs button.on { color:var(--fg); font-weight:600; border-bottom-color: var(--fg); }
  .vsearch { color:var(--muted); font-size:14px; padding:4px 10px; border-radius:4px; }
  .gsec { font-size:16px; font-weight:600; margin: 28px 0 12px; }
  .gsec:first-child { margin-top: 4px; }
  .gallery { display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:16px; }
  @media (max-width: 960px) { .gallery { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 600px) { .gallery { grid-template-columns: 1fr; } .wrap.wide { padding-left:20px; padding-right:20px; } .ptitle { font-size:32px; } }
  .gcard { display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:8px; overflow:hidden; color:var(--fg); transition: background .15s; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
  .gcard:hover { text-decoration:none; background: var(--hover); }
  .gcard:hover .gprev { filter: brightness(1.06); }
  .gprev { background:var(--prev); padding:12px 14px; height:150px; overflow:hidden; border-bottom:1px solid var(--line); }
  .gmeta { display:flex; gap:8px; align-items:center; font-size:12px; color:var(--muted); margin-bottom:8px; }
  .gbadge { border-radius:4px; padding:0 6px; line-height:20px; background:var(--b1); color:var(--b1f); }
  .gbadge.tech { background:var(--b2); color:var(--b2f); }
  .gprev ul { margin:0; padding-left:16px; font-size:12.5px; line-height:1.6; color:var(--muted); }
  .gprev li { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-bottom:4px; }
  .gtitle { display:flex; gap:8px; align-items:center; padding:10px 14px; font-weight:600; font-size:14.5px; line-height:1.4; }
  .gtitle span:last-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
</style>
