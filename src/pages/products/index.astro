---
import Base from '../../layouts/Base.astro';
import RankTable from '../../components/RankTable.astro';
import { url } from '../../lib/posts';
import { favBtn } from '../../lib/icons';
import I from '../../components/I.astro';
import L from '../../components/L.astro';
import { t, iattr } from '../../lib/i18n';
import { allProducts, badges, latestSnapshots, bjToday, addDays } from '../../lib/products';
import { PRODUCT_CATEGORIES } from '../../content.config';
const products = await allProducts();
const today = bjToday();
const weekAgo = addDays(today, -7);
const fresh = products.filter((p) => p.firstSeen > weekAgo).sort((a, b) => (a.firstSeen < b.firstSeen ? 1 : -1));
const cats = PRODUCT_CATEGORIES.filter((c) => products.some((p) => p.category === c));
const pmap: Record<string, string> = {};
// 让榜单里的名称能点回本站产品页（只用于链接，不合并数据）
for (const p of products) for (const r of p.rankings) if (r.snap) {
  const [key, date] = r.snap.split('/');
  const snap = latestSnapshots().find((x) => x.key === key)?.history.find((h) => h.date === date);
  const row = snap?.rows.find((x) => x.rank === r.rank);
  if (row) pmap[row.name] = url(`/products/${p.id}/`);
}
const prodBoards = latestSnapshots().filter((b) => b.latest.kind !== 'models');
const order = (k: string) => ['aicpb-pc-office', 'aicpb-pc-growth', 'aicpb-china-ai-app', 'aicpb-china-ai-web', 'openrouter-apps-week', 'a16z-web', 'a16z-mobile', 'producthunt-ai', 'hf-spaces-trending'].indexOf(k) + 1 || 50;
prodBoards.sort((a, b) => order(a.key) - order(b.key) || a.key.localeCompare(b.key));
const modelBoards = latestSnapshots('models').sort((a, b) => ['openrouter-models-week', 'aa-intelligence', 'lmarena-text'].indexOf(a.key) - ['openrouter-models-week', 'aa-intelligence', 'lmarena-text'].indexOf(b.key));
const sorted = [...products].sort((a, b) => (b.score || 0) - (a.score || 0) || a.name.localeCompare(b.name));
---
<Base wide tkey="p.title" description="AI product library: rankings from a16z, AICPB, OpenRouter and more, plus our daily digests">
  <h1 class="ptitle"><span>🧩</span> <I k="p.title" /></h1>
  <I tag="p" class="muted" k="p.intro" a={{ n: products.length }} />
  <div class="views" data-pagefind-ignore>
    <div class="vtabs" role="tablist">
      <button type="button" data-tab="all" class="on"><I k="p.tab.all" /></button>
      <button type="button" data-tab="rank"><I k="p.tab.rank" /></button>
      <button type="button" data-tab="models"><I k="p.tab.models" /></button>
    </div>
    <I tag="a" class="vsearch" href={url('/search/')} k="p.search" />
  </div>

  <div data-panel="all">
    {fresh.length > 0 && <section class="fresh">
      <div class="gsec"><I k="p.fresh" /> <I class="muted" k="p.fresh.sub" a={{ d: weekAgo }} /></div>
      <div class="fstrip">{fresh.map((p) => <a class="fchip" href={url(`/products/${p.id}/`)}><b>{p.name}</b><span class="muted">{p.firstSeen.slice(5)} · <I k={`cat.${p.category}`} /></span></a>)}</div>
    </section>}
    <div class="pbar">
      <div class="pchips" data-cat>
        <button type="button" class="on" data-v=""><I k="all" /></button>
        {cats.map((c) => <button type="button" data-v={c}><I k={`cat.${c}`} /></button>)}
      </div>
      <div class="pctl">
        <div class="pchips" data-region>
          <button type="button" class="on" data-v=""><I k="all" /></button><button type="button" data-v="cn"><I k="region.cn" /></button><button type="button" data-v="global"><I k="region.global" /></button>
        </div>
        <select data-sort {...iattr({ 'aria-label': 'sort' })}>
          <I tag="option" value="score" k="p.s.score" />
          <I tag="option" value="trend" k="p.s.trend" />
          <I tag="option" value="new" k="p.s.new" />
        </select>
      </div>
    </div>
    <p class="muted" data-count></p>
    <div class="gallery" data-grid>
      {sorted.map((p) => {
        const bs = badges(p).slice(0, 3);
        return <article class="gcard pcard" data-id={p.id} data-cat={p.category} data-region={p.region} data-score={p.score || 0} data-growth={p.growth ?? ''} data-first={p.firstSeen}>
          <div class="gtitle"><a class="pname" href={url(`/products/${p.id}/`)}>{p.name}</a>{p.score && <span class={`ascore s${p.score}`} {...iattr({ title: 'ai.score', 'aria-label': 'ai.score' }, { n: p.score })}>{p.score}</span>}</div>
          <div class="gmeta"><span class={`gbadge ${p.region === 'cn' ? 'tech' : ''}`}><I k={`region.${p.region}`} /></span><I k={`cat.${p.category}`} />{p.maker && <span>· {p.maker}</span>}</div>
          <p class="gsum"><L en={p.oneLinerEn} zh={p.oneLiner} /></p>
          <div class="gfoot">
            {bs.map((r) => <span class="rbadge" title={`${r.list} · ${r.date}`}>{r.badge} #{r.rank}</span>)}
            {p.growth != null && <span class:list={['grow', p.growth >= 0 ? 'up' : 'down']} title={p.growthNote}>{p.growth >= 0 ? '↑' : '↓'}{Math.abs(p.growth).toFixed(1)}%</span>}
          </div>
          <div class="pact">
            <I tag="a" class="ibtn" href={p.url} target="_blank" rel="noopener" k="p.site" />
            <Fragment set:html={favBtn('data-fav')} />
            <span class="prd muted" data-mine></span>
          </div>
        </article>;
      })}
    </div>
  </div>

  <div data-panel="rank" hidden>
    <I tag="p" class="muted" k="p.rank.note" />
    <div class="rgrid">{prodBoards.map((b) => <RankTable s={b.latest} history={b.history} pmap={pmap} limit={b.latest.kind === 'feed' ? 15 : 20} />)}</div>
  </div>

  <div data-panel="models" hidden id="models">
    <I tag="p" class="muted mnote" k="p.models.note" />
    <div class="rgrid">{modelBoards.map((b) => <RankTable s={b.latest} history={b.history} />)}</div>
  </div>
</Base>
<script>
  import { load, save } from '../../lib/store';
  import { setFav, setRead, starsStatic } from '../../lib/icons';
  import { tt, getLang, onLang } from '../../lib/i18n';
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  const show = (t: string) => { tabs.forEach((b) => b.classList.toggle('on', b.dataset.tab === t)); panels.forEach((p) => (p.hidden = p.dataset.panel !== t)); };
  tabs.forEach((b) => b.addEventListener('click', () => { show(b.dataset.tab!); history.replaceState(null, '', b.dataset.tab === 'all' ? location.pathname : `#${b.dataset.tab}`); }));
  const h = location.hash.slice(1); if (h === 'rank' || h === 'models') show(h);

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.pcard')];
  const state = { cat: '', region: '' };
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const qs = new URLSearchParams(location.search);
  if (qs.get('sort')) sortSel.value = qs.get('sort')!;
  function apply() {
    const k = sortSel.value;
    const val = (c: HTMLElement) => k === 'score' ? Number(c.dataset.score) : k === 'trend' ? (c.dataset.growth === '' ? -1e9 : Number(c.dataset.growth)) : 0;
    cards.sort((a, b) => k === 'new' ? (a.dataset.first! < b.dataset.first! ? 1 : a.dataset.first! > b.dataset.first! ? -1 : 0) : val(b) - val(a));
    let n = 0;
    for (const c of cards) {
      const ok = (!state.cat || c.dataset.cat === state.cat) && (!state.region || c.dataset.region === state.region);
      c.hidden = !ok; if (ok) n++; grid.appendChild(c);
    }
    document.querySelector('[data-count]')!.textContent = tt('p.count', { n, t: cards.length });
  }
  for (const [sel, key] of [['[data-cat]', 'cat'], ['[data-region]', 'region']] as const) {
    const box = document.querySelector(sel)!;
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      box.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
      state[key] = b.dataset.v || ''; apply();
    });
  }
  sortSel.addEventListener('change', apply);
  const gs = (c: HTMLElement) => (c.querySelector(`.gsum [data-l=${getLang()}]`) || c.querySelector('.gsum'))!.textContent || '';
  const KEY = (id: string) => `product:${id}`;
  function paint() {
    const st = load();
    for (const c of cards) {
      const k = KEY(c.dataset.id!);
      const fav = !!st.fav[k]; const b = c.querySelector('[data-fav]')!;
      setFav(b, fav);
      const r = st.rating[k];
      c.querySelector('[data-mine]')!.innerHTML = starsStatic(r || 0) + (st.read[k] ? ` <span>${tt('p.seen')}</span>` : '');
      c.classList.toggle('done', !!st.read[k]);
    }
  }
  grid.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-fav]'); if (!b) return;
    const c = b.closest<HTMLElement>('.pcard')!; const k = KEY(c.dataset.id!);
    const st = load();
    if (st.fav[k]) delete st.fav[k];
    else st.fav[k] = { id: k, day: c.dataset.first!, html: `<p><strong>${c.querySelector('.pname')!.textContent}</strong>: ${gs(c)}</p>`, text: gs(c), score: Number(c.dataset.score) || undefined, ts: Date.now() };
    save(st); paint();
  });
  apply(); paint(); onLang(() => { apply(); paint(); });
</script>
